<Window x:Class="Chipmunk.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chipmunk 설정"
        Icon="/Chipmunk;component/Assets/chipmunk.ico"
        Width="650"
        Height="760"
        MinWidth="580"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="230" />
            <Setter Property="Height" Value="28" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FFE05B5B"
                       Margin="0,4,0,8"
                       TextWrapping="Wrap" />
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="기본값 불러오기"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Command="{Binding RestoreDefaultsCommand}" />
                    <Button Content="설정 내보내기"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="OnExportClick" />
                    <Button Content="위치 초기화"
                            Padding="12,6"
                            Click="OnResetPositionClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소"
                            Padding="16,6"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}" />
                    <Button Content="적용"
                            Padding="18,6"
                            IsDefault="True"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <StackPanel>
                <Border Height="120"
                        Margin="0,0,0,10"
                        CornerRadius="12"
                        ClipToBounds="True">
                    <Image Source="/Chipmunk;component/Assets/chipmunk_logo.png"
                           Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="센서를 읽을 수 없는 항목은 N/A로 표시됩니다."
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           Margin="0,0,0,16" />

                <GroupBox Header="표시 항목">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox Content="CPU 온도" IsChecked="{Binding Draft.ShowCpuTemperature}" />
                            <CheckBox Content="CPU 사용률" IsChecked="{Binding Draft.ShowCpuUsage}" />
                            <CheckBox Content="GPU 온도" IsChecked="{Binding Draft.ShowGpuTemperature}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox Content="GPU 사용률" IsChecked="{Binding Draft.ShowGpuUsage}" />
                            <CheckBox Content="GPU 메모리" IsChecked="{Binding Draft.ShowGpuMemory}" />
                            <CheckBox Content="시스템 메모리" IsChecked="{Binding Draft.ShowSystemMemory}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="센서 및 갱신">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="표시 GPU" Margin="0,5" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding GpuOptions}"
                                  SelectedItem="{Binding SelectedGpu}"
                                  DisplayMemberPath="DisplayName" />
                        <TextBlock Grid.Row="1" Text="갱신 주기" Margin="0,10,0,5" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"
                                  ItemsSource="{Binding UpdateIntervals}"
                                  SelectedItem="{Binding Draft.UpdateIntervalMilliseconds}" />
                        <TextBlock Grid.Row="2" Text="온도 단위" Margin="0,10,0,5" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,5,0,0"
                                  ItemsSource="{Binding TemperatureUnits}"
                                  SelectedItem="{Binding Draft.TemperatureUnit}" />
                        <TextBlock Grid.Row="3" Text="소수점 자릿수" Margin="0,10,0,5" />
                        <Slider Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"
                                Minimum="0" Maximum="2" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Draft.DecimalDigits}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="경고 임계값">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="55" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="온도 주의 (°C)" />
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="40" Maximum="100"
                                Value="{Binding Draft.Thresholds.TemperatureWarning}" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding Draft.Thresholds.TemperatureWarning, StringFormat={}{0:F0}}" />
                        <TextBlock Grid.Row="1" Text="온도 위험 (°C)" Margin="0,10,0,0" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="50" Maximum="120" Margin="0,10,0,0"
                                Value="{Binding Draft.Thresholds.TemperatureCritical}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"
                                   Text="{Binding Draft.Thresholds.TemperatureCritical, StringFormat={}{0:F0}}" />
                        <TextBlock Grid.Row="2" Text="사용률 주의 (%)" Margin="0,10,0,0" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="40" Maximum="100" Margin="0,10,0,0"
                                Value="{Binding Draft.Thresholds.UsageWarning}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,10,0,0"
                                   Text="{Binding Draft.Thresholds.UsageWarning, StringFormat={}{0:F0}}" />
                        <TextBlock Grid.Row="3" Text="사용률 위험 (%)" Margin="0,10,0,0" />
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="50" Maximum="100" Margin="0,10,0,0"
                                Value="{Binding Draft.Thresholds.UsageCritical}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,10,0,0"
                                   Text="{Binding Draft.Thresholds.UsageCritical, StringFormat={}{0:F0}}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="모양">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="55" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="글꼴 크기" />
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="9" Maximum="30"
                                Value="{Binding Draft.FontSize}" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding Draft.FontSize, StringFormat={}{0:F0}}" />
                        <TextBlock Grid.Row="1" Text="배경 불투명도" Margin="0,10,0,0" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0.2" Maximum="1" Margin="0,10,0,0"
                                Value="{Binding Draft.BackgroundOpacity}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"
                                   Text="{Binding Draft.BackgroundOpacity, StringFormat={}{0:P0}}" />
                        <TextBlock Grid.Row="2" Text="레이아웃" Margin="0,10,0,0" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                  ItemsSource="{Binding Layouts}"
                                  SelectedItem="{Binding Draft.Layout}" />
                        <TextBlock Grid.Row="3" Text="테마" Margin="0,10,0,0" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding Draft.Theme}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="위치 및 동작">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="55" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="표시 모니터" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding MonitorOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="DeviceName"
                                  SelectedValue="{Binding Draft.MonitorDeviceName}" />
                        <TextBlock Grid.Row="1" Text="작업표시줄 여백" Margin="0,10,0,0" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="50" Margin="0,10,0,0"
                                Value="{Binding Draft.TaskbarMargin}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"
                                   Text="{Binding Draft.TaskbarMargin, StringFormat={}{0:F0}px}" />
                        <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                  Content="Windows 시작 시 자동 실행"
                                  IsChecked="{Binding Draft.StartWithWindows}" />
                        <CheckBox Grid.Row="3" Grid.ColumnSpan="3"
                                  Content="항상 위에 표시"
                                  IsChecked="{Binding Draft.AlwaysOnTop}" />
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="3"
                                  Content="클릭 통과 모드"
                                  IsChecked="{Binding Draft.ClickThrough}" />
                        <TextBlock Grid.Row="5" Text="더블 클릭 동작" Margin="0,10,0,0" />
                        <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                  ItemsSource="{Binding DoubleClickActions}"
                                  SelectedItem="{Binding Draft.DoubleClickAction}" />
                        <CheckBox Grid.Row="6" Grid.ColumnSpan="3"
                                  Content="PawnIO 설치 안내를 다시 표시하지 않음"
                                  IsChecked="{Binding Draft.SuppressPawnIoInstallPrompt}" />
                        <TextBlock Grid.Row="7" Grid.ColumnSpan="3"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Text="클릭 통과 모드에서는 위젯이 마우스 입력을 받지 않습니다. 시스템 트레이 메뉴에서 해제할 수 있습니다." />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
