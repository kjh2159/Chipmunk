<Window x:Class="Chipmunk.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsWindowTitle}"
        Icon="/Chipmunk;component/Assets/chipmunk.ico"
        Width="650"
        Height="760"
        MinWidth="580"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="230" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource DropDownForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource DropDownBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DropDownComboBoxItemStyle}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FFE05B5B"
                       Margin="0,4,0,8"
                       TextWrapping="Wrap" />
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="{DynamicResource SettingsRestoreDefaults}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Command="{Binding RestoreDefaultsCommand}" />
                    <Button Content="{DynamicResource SettingsExport}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="OnExportClick" />
                    <Button Content="{DynamicResource SettingsResetPosition}"
                            Padding="12,6"
                            Click="OnResetPositionClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource CommonCancel}"
                            Padding="16,6"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}" />
                    <Button Content="{DynamicResource CommonApply}"
                            Padding="18,6"
                            IsDefault="True"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <StackPanel>
                <Border Height="120"
                        Margin="0,0,0,10"
                        CornerRadius="12"
                        ClipToBounds="True">
                    <Image Source="/Chipmunk;component/Assets/chipmunk_logo.png"
                           Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="{DynamicResource SensorUnavailableNote}"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           Margin="0,0,0,16" />

                <GroupBox Header="{DynamicResource GroupLanguage}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource LanguageLabel}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding LanguageOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="{DynamicResource GroupDisplayedItems}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox Content="{DynamicResource ShowCpuTemperature}" IsChecked="{Binding Draft.ShowCpuTemperature}" />
                            <CheckBox Content="{DynamicResource ShowCpuUsage}" IsChecked="{Binding Draft.ShowCpuUsage}" />
                            <CheckBox Content="{DynamicResource ShowGpuTemperature}" IsChecked="{Binding Draft.ShowGpuTemperature}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox Content="{DynamicResource ShowGpuUsage}" IsChecked="{Binding Draft.ShowGpuUsage}" />
                            <CheckBox Content="{DynamicResource ShowGpuMemory}" IsChecked="{Binding Draft.ShowGpuMemory}" />
                            <CheckBox Content="{DynamicResource ShowSystemMemory}" IsChecked="{Binding Draft.ShowSystemMemory}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="{DynamicResource GroupSensorsRefresh}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource DisplayGpu}" Margin="0,5" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding GpuOptions}"
                                  SelectedItem="{Binding SelectedGpu}"
                                  DisplayMemberPath="DisplayName" />
                        <TextBlock Grid.Row="1" Text="{DynamicResource UpdateInterval}" Margin="0,10,0,5" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"
                                  ItemsSource="{Binding UpdateIntervals}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Draft.UpdateIntervalMilliseconds, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource TemperatureUnitLabel}" Margin="0,10,0,5" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,5,0,0"
                                  ItemsSource="{Binding TemperatureUnits}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Draft.TemperatureUnit, Mode=TwoWay}" />
                        <TextBlock Grid.Row="3" Text="{DynamicResource DecimalDigits}" Margin="0,10,0,5" />
                        <Slider Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"
                                Minimum="0" Maximum="2" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Draft.DecimalDigits}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="{DynamicResource GroupThresholds}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="55" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource TemperatureWarning}" />
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="40" Maximum="100"
                                Value="{Binding Draft.Thresholds.TemperatureWarning}" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding Draft.Thresholds.TemperatureWarning, StringFormat={}{0:F0}}" />
                        <TextBlock Grid.Row="1" Text="{DynamicResource TemperatureCritical}" Margin="0,10,0,0" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="50" Maximum="120" Margin="0,10,0,0"
                                Value="{Binding Draft.Thresholds.TemperatureCritical}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"
                                   Text="{Binding Draft.Thresholds.TemperatureCritical, StringFormat={}{0:F0}}" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource UsageWarning}" Margin="0,10,0,0" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="40" Maximum="100" Margin="0,10,0,0"
                                Value="{Binding Draft.Thresholds.UsageWarning}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,10,0,0"
                                   Text="{Binding Draft.Thresholds.UsageWarning, StringFormat={}{0:F0}}" />
                        <TextBlock Grid.Row="3" Text="{DynamicResource UsageCritical}" Margin="0,10,0,0" />
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="50" Maximum="100" Margin="0,10,0,0"
                                Value="{Binding Draft.Thresholds.UsageCritical}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,10,0,0"
                                   Text="{Binding Draft.Thresholds.UsageCritical, StringFormat={}{0:F0}}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="{DynamicResource GroupAppearance}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="55" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource FontSizeLabel}" />
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="9" Maximum="30"
                                Value="{Binding Draft.FontSize}" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding Draft.FontSize, StringFormat={}{0:F0}}" />
                        <TextBlock Grid.Row="1" Text="{DynamicResource BackgroundOpacityLabel}" Margin="0,10,0,0" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0.2" Maximum="1" Margin="0,10,0,0"
                                Value="{Binding Draft.BackgroundOpacity}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"
                                   Text="{Binding Draft.BackgroundOpacity, StringFormat={}{0:P0}}" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource LayoutLabel}" Margin="0,10,0,0" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                  ItemsSource="{Binding Layouts}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Draft.Layout, Mode=TwoWay}" />
                        <TextBlock Grid.Row="3" Text="{DynamicResource ThemeLabel}" Margin="0,10,0,0" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                  ItemsSource="{Binding Themes}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Draft.Theme, Mode=TwoWay}" />
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                  Content="{DynamicResource FixedWidgetSize}"
                                  IsChecked="{Binding Draft.IsWidgetSizeFixed}" />
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="3"
                                   Margin="0,7,0,0"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource FlexibleWidgetSizeNote}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="{DynamicResource GroupPositionBehavior}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="55" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource DisplayMonitor}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding MonitorOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="DeviceName"
                                  SelectedValue="{Binding Draft.MonitorDeviceName}" />
                        <TextBlock Grid.Row="1" Text="{DynamicResource TaskbarMargin}" Margin="0,10,0,0" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="50" Margin="0,10,0,0"
                                Value="{Binding Draft.TaskbarMargin}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"
                                   Text="{Binding Draft.TaskbarMargin, StringFormat={}{0:F0}px}" />
                        <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                  Content="{DynamicResource StartWithWindows}"
                                  IsChecked="{Binding Draft.StartWithWindows}" />
                        <CheckBox Grid.Row="3" Grid.ColumnSpan="3"
                                  Content="{DynamicResource AlwaysOnTop}"
                                  IsChecked="{Binding Draft.AlwaysOnTop}" />
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="3"
                                  Content="{DynamicResource ClickThroughMode}"
                                  IsChecked="{Binding Draft.ClickThrough}" />
                        <TextBlock Grid.Row="5" Text="{DynamicResource DoubleClickActionLabel}" Margin="0,10,0,0" />
                        <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                  ItemsSource="{Binding DoubleClickActions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Draft.DoubleClickAction, Mode=TwoWay}" />
                        <CheckBox Grid.Row="6" Grid.ColumnSpan="3"
                                  Content="{DynamicResource SuppressPawnIoPrompt}"
                                  IsChecked="{Binding Draft.SuppressPawnIoInstallPrompt}" />
                        <TextBlock Grid.Row="7" Grid.ColumnSpan="3"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource ClickThroughNote}" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
