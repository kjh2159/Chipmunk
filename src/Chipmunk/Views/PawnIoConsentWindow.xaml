<Window x:Class="Chipmunk.Views.PawnIoConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PawnIoConsentTitle}"
        Icon="/Chipmunk;component/Assets/chipmunk.ico"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource PawnIoConsentHeader}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Text="{DynamicResource PawnIoConsentDescription}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="14"
                CornerRadius="8"
                Background="#1470A5FF">
            <StackPanel>
                <TextBlock Text="{DynamicResource PawnIoComponentsHeader}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource PawnIoComponentsDetails}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,14,0,18"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SubtleForegroundBrush}">
            <Run Text="{DynamicResource PawnIoPrivacyNote}" />
            <LineBreak />
            <Hyperlink NavigateUri="https://pawnio.eu/"
                       RequestNavigate="OnLinkNavigate"><Run Text="{DynamicResource PawnIoOfficialSite}" /></Hyperlink>
            <Run Text=" · " />
            <Hyperlink NavigateUri="https://github.com/namazso/PawnIO.Setup/releases/tag/2.2.0"
                       RequestNavigate="OnLinkNavigate"><Run Text="{DynamicResource PawnIoOfficialRelease}" /></Hyperlink>
        </TextBlock>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="{DynamicResource PawnIoNeverAskAgain}"
                    HorizontalAlignment="Left"
                    Padding="12,7"
                    Click="OnNeverAskAgain" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource PawnIoLater}"
                        Padding="16,7"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="OnLater" />
                <Button Content="{DynamicResource PawnIoAgreeInstall}"
                        Padding="18,7"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        Click="OnInstall" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
