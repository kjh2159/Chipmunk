<Window x:Class="Chipmunk.Views.DetailedMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource DetailedWindowTitle}"
        Icon="/Chipmunk;component/Assets/chipmunk.ico"
        Width="620"
        Height="330"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource DetailedHeader}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,18" />
        <Border Grid.Row="1"
                Padding="20"
                CornerRadius="10"
                Background="{DynamicResource WidgetBackgroundBrush}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayText}"
                           FontFamily="Consolas"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WidgetForegroundBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ToolTipText}"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2"
                   Margin="0,14,0,0"
                   Foreground="{DynamicResource SubtleForegroundBrush}"
                   Text="{DynamicResource DetailedFooter}" />
    </Grid>
</Window>
