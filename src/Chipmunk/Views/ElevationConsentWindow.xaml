<Window x:Class="Chipmunk.Views.ElevationConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ElevationConsentTitle}"
        Icon="/Chipmunk;component/Assets/chipmunk.ico"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource ElevationConsentHeader}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Text="{DynamicResource ElevationConsentDescription}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,18"
                Padding="14"
                CornerRadius="8"
                Background="#1470A5FF">
            <TextBlock Text="{DynamicResource ElevationConsentUacNote}"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="{DynamicResource ElevationContinueNormally}"
                    Padding="16,7"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnContinueNormally" />
            <Button Content="{DynamicResource ElevationRestartAsAdministrator}"
                    Padding="18,7"
                    FontWeight="SemiBold"
                    IsDefault="True"
                    Click="OnRestartAsAdministrator" />
        </StackPanel>
    </Grid>
</Window>
