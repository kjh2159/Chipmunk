<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\chipmunk.ico</ApplicationIcon>
    <AssemblyName>Chipmunk</AssemblyName>
    <RootNamespace>Chipmunk</RootNamespace>
    <AssemblyTitle>Chipmunk</AssemblyTitle>
    <Product>Chipmunk</Product>
    <Description>Lightweight real-time system monitoring widget for Windows.</Description>
    <Company>Chipmunk contributors</Company>
    <Version>1.0.0</Version>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\chipmunk.ico" />
    <Resource Include="Assets\chipmunk_logo.png" />
    <Resource Include="Assets\chipmunk_logo_2.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\LICENSE"
          Link="LICENSE"
          CopyToOutputDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\PAWNIO-NOTICE.md"
          Link="PAWNIO-NOTICE.md"
          CopyToOutputDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <Content Include="..\..\installer\dependencies\PawnIO_setup.exe"
             Link="Dependencies\PawnIO_setup.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
