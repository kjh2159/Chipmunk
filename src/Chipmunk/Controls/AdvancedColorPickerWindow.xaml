<Window x:Class="Chipmunk.Controls.AdvancedColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ColorPickerTitle}"
        Icon="/Chipmunk;component/Assets/chipmunk.ico"
        Width="430"
        Height="365"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        Loaded="OnLoaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource ColorPickerContinuousPalette}"
                   Margin="0,0,0,8" />

        <Grid Grid.Row="1" Height="190">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="26" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ColorField"
                  ClipToBounds="True"
                  Cursor="Cross"
                  MouseLeftButtonDown="OnColorFieldMouseDown"
                  MouseMove="OnColorFieldMouseMove"
                  MouseLeftButtonUp="OnPickerMouseUp"
                  SizeChanged="OnPickerSizeChanged">
                <Border x:Name="HueBase" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="White" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="Black" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="ColorMarker"
                             Width="12"
                             Height="12"
                             Stroke="White"
                             StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="2" Opacity="0.8" ShadowDepth="0" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <Grid x:Name="HueStrip"
                  Grid.Column="2"
                  ClipToBounds="False"
                  Cursor="Hand"
                  MouseLeftButtonDown="OnHueMouseDown"
                  MouseMove="OnHueMouseMove"
                  MouseLeftButtonUp="OnPickerMouseUp"
                  SizeChanged="OnPickerSizeChanged">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="HueMarker"
                               Width="34"
                               Height="4"
                               RadiusX="1"
                               RadiusY="1"
                               Stroke="White"
                               StrokeThickness="2"
                               Fill="Transparent" />
                </Canvas>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ColorPreview"
                    Width="42"
                    Height="30"
                    Margin="0,0,12,0"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" />
            <TextBlock Grid.Column="1"
                       Text="{DynamicResource ColorPickerHexLabel}" />
            <TextBox x:Name="HexTextBox"
                     Grid.Column="3"
                     Height="28"
                     MinWidth="112"
                     MaxLength="9"
                     VerticalContentAlignment="Center"
                     TextChanged="OnHexTextChanged" />
        </Grid>

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="3"
                   Margin="164,5,0,0"
                   VerticalAlignment="Top"
                   Foreground="#FFE05B5B"
                   Text="{DynamicResource ColorPickerInvalidHex}"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{DynamicResource CommonCancel}"
                    MinWidth="82"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="{DynamicResource CommonApply}"
                    MinWidth="82"
                    Padding="12,6"
                    IsDefault="True"
                    Click="OnAcceptClick" />
        </StackPanel>
    </Grid>
</Window>
